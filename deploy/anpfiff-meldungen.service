[Unit]
Description=Anpfiff Niederrhein – Meldungen einsammeln
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=anpfiff
WorkingDirectory=/opt/anpfiff/quelle
ExecStart=/usr/bin/node scripts/fetch.mjs
# Ein hängender Abruf darf den Zeitgeber nicht blockieren.
TimeoutStartSec=600
Nice=10
