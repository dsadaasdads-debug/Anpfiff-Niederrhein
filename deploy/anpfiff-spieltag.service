[Unit]
Description=Anpfiff Niederrhein – Spieltag und Ticker
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=anpfiff
WorkingDirectory=/opt/anpfiff/quelle
ExecStart=/usr/bin/node scripts/live.mjs
# Kurz halten: der Zeitgeber ruft ohnehin gleich wieder auf.
TimeoutStartSec=300
Nice=5
